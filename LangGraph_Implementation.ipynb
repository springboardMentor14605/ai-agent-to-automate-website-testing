     "output_type": "stream",
     "text": [
      "Ask something (type exit to stop):  exit\n"
     ]
    }
   ],
   "source": [
    "while True:\n",
    "    query = input(\"Ask something (type exit to stop): \")\n",
    "    if query.lower() == \"exit\":\n",
    "        break\n",
    "\n",
    "    result = app.invoke({\n",
    "        \"user_input\": query,\n",
    "        \"agent_response\": \"\"\n",
    "    })\n",
    "\n",
    "    print(\"\\nAgent:\", result[\"agent_response\"])\n"
   ]
  },
